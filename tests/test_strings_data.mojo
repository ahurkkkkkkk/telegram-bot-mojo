from std.testing import assert_equal
from telegram._utils.strings import to_camel_case


def main() raises:
    assert_equal(to_camel_case("unchanged_ aBc"), "unchanged Abc")
    assert_equal(to_camel_case("unchanged_!aBc"), "unchanged!Abc")
    assert_equal(to_camel_case("unchanged_\"aBc"), "unchanged\"Abc")
    assert_equal(to_camel_case("unchanged_#aBc"), "unchanged#Abc")
    assert_equal(to_camel_case("unchanged_$aBc"), "unchanged$Abc")
    assert_equal(to_camel_case("unchanged_%aBc"), "unchanged%Abc")
    assert_equal(to_camel_case("unchanged_&aBc"), "unchanged&Abc")
    assert_equal(to_camel_case("unchanged_'aBc"), "unchanged'Abc")
    assert_equal(to_camel_case("unchanged_(aBc"), "unchanged(Abc")
    assert_equal(to_camel_case("unchanged_)aBc"), "unchanged)Abc")
    assert_equal(to_camel_case("unchanged_*aBc"), "unchanged*Abc")
    assert_equal(to_camel_case("unchanged_+aBc"), "unchanged+Abc")
    assert_equal(to_camel_case("unchanged_,aBc"), "unchanged,Abc")
    assert_equal(to_camel_case("unchanged_-aBc"), "unchanged-Abc")
    assert_equal(to_camel_case("unchanged_.aBc"), "unchanged.Abc")
    assert_equal(to_camel_case("unchanged_/aBc"), "unchanged/Abc")
    assert_equal(to_camel_case("unchanged_0aBc"), "unchanged0Abc")
    assert_equal(to_camel_case("unchanged_1aBc"), "unchanged1Abc")
    assert_equal(to_camel_case("unchanged_2aBc"), "unchanged2Abc")
    assert_equal(to_camel_case("unchanged_3aBc"), "unchanged3Abc")
    assert_equal(to_camel_case("unchanged_4aBc"), "unchanged4Abc")
    assert_equal(to_camel_case("unchanged_5aBc"), "unchanged5Abc")
    assert_equal(to_camel_case("unchanged_6aBc"), "unchanged6Abc")
    assert_equal(to_camel_case("unchanged_7aBc"), "unchanged7Abc")
    assert_equal(to_camel_case("unchanged_8aBc"), "unchanged8Abc")
    assert_equal(to_camel_case("unchanged_9aBc"), "unchanged9Abc")
    assert_equal(to_camel_case("unchanged_:aBc"), "unchanged:Abc")
    assert_equal(to_camel_case("unchanged_;aBc"), "unchanged;Abc")
