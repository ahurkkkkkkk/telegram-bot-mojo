    assert_equal(to_camel_case("unchanged_faBc"), "unchangedFabc")
    assert_equal(to_camel_case("unchanged_gaBc"), "unchangedGabc")
    assert_equal(to_camel_case("unchanged_haBc"), "unchangedHabc")
    assert_equal(to_camel_case("unchanged_iaBc"), "unchangedIabc")
    assert_equal(to_camel_case("unchanged_jaBc"), "unchangedJabc")
    assert_equal(to_camel_case("unchanged_kaBc"), "unchangedKabc")
    assert_equal(to_camel_case("unchanged_laBc"), "unchangedLabc")
    assert_equal(to_camel_case("unchanged_maBc"), "unchangedMabc")
    assert_equal(to_camel_case("unchanged_naBc"), "unchangedNabc")
    assert_equal(to_camel_case("unchanged_oaBc"), "unchangedOabc")
    assert_equal(to_camel_case("unchanged_paBc"), "unchangedPabc")
    assert_equal(to_camel_case("unchanged_qaBc"), "unchangedQabc")
    assert_equal(to_camel_case("unchanged_raBc"), "unchangedRabc")
    assert_equal(to_camel_case("unchanged_saBc"), "unchangedSabc")
    assert_equal(to_camel_case("unchanged_taBc"), "unchangedTabc")
    assert_equal(to_camel_case("unchanged_uaBc"), "unchangedUabc")
    assert_equal(to_camel_case("unchanged_vaBc"), "unchangedVabc")
    assert_equal(to_camel_case("unchanged_waBc"), "unchangedWabc")
    assert_equal(to_camel_case("unchanged_xaBc"), "unchangedXabc")
    assert_equal(to_camel_case("unchanged_yaBc"), "unchangedYabc")
    assert_equal(to_camel_case("unchanged_zaBc"), "unchangedZabc")
    assert_equal(to_camel_case("unchanged_{aBc"), "unchanged{Abc")
    assert_equal(to_camel_case("unchanged_|aBc"), "unchanged|Abc")
    assert_equal(to_camel_case("unchanged_}aBc"), "unchanged}Abc")
    assert_equal(to_camel_case("unchanged_~aBc"), "unchanged~Abc")
    assert_equal(to_camel_case(""), "")
    assert_equal(to_camel_case("single"), "single")
    assert_equal(to_camel_case("_leading"), "Leading")
    assert_equal(to_camel_case("trailing_"), "trailing")
    assert_equal(to_camel_case("many___separators"), "manySeparators")
    assert_equal(to_camel_case("first_unchanged_second_word"), "firstUnchangedSecondWord")
