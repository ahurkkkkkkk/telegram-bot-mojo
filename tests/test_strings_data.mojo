    assert_equal(to_camel_case("unchanged_KaBc"), "unchangedKabc")
    assert_equal(to_camel_case("unchanged_LaBc"), "unchangedLabc")
    assert_equal(to_camel_case("unchanged_MaBc"), "unchangedMabc")
    assert_equal(to_camel_case("unchanged_NaBc"), "unchangedNabc")
    assert_equal(to_camel_case("unchanged_OaBc"), "unchangedOabc")
    assert_equal(to_camel_case("unchanged_PaBc"), "unchangedPabc")
    assert_equal(to_camel_case("unchanged_QaBc"), "unchangedQabc")
    assert_equal(to_camel_case("unchanged_RaBc"), "unchangedRabc")
    assert_equal(to_camel_case("unchanged_SaBc"), "unchangedSabc")
