    assert_equal(to_camel_case("unchanged_=aBc"), "unchanged=Abc")
    assert_equal(to_camel_case("unchanged_>aBc"), "unchanged>Abc")
    assert_equal(to_camel_case("unchanged_?aBc"), "unchanged?Abc")
    assert_equal(to_camel_case("unchanged_@aBc"), "unchanged@Abc")
    assert_equal(to_camel_case("unchanged_AaBc"), "unchangedAabc")
    assert_equal(to_camel_case("unchanged_BaBc"), "unchangedBabc")
    assert_equal(to_camel_case("unchanged_CaBc"), "unchangedCabc")
    assert_equal(to_camel_case("unchanged_DaBc"), "unchangedDabc")
    assert_equal(to_camel_case("unchanged_EaBc"), "unchangedEabc")
    assert_equal(to_camel_case("unchanged_FaBc"), "unchangedFabc")
    assert_equal(to_camel_case("unchanged_GaBc"), "unchangedGabc")
